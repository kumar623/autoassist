# Copy to .env and fill in. NEVER commit .env

# --- Azure AI Foundry project ---
# Foundry portal > your project > Overview > "Azure AI Foundry project endpoint"
PROJECT_ENDPOINT=https://rg-autoassist.services.ai.azure.com/api/projects/autoassist

# --- Azure OpenAI (same resource, different endpoint shape) ---
# Foundry portal > Models + endpoints > click gpt-4.1-mini > copy "Target URI"
# and keep only the part up to .com/  -- do NOT include /openai/deployments/...
AZURE_OPENAI_ENDPOINT=https://rg-autoassist.services.ai.azure.com/
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_API_VERSION=2025-04-01-preview

# Only scripts/generate_bulletins.py reads CHAT_DEPLOYMENT; the agents' model is
# set in agents/definitions/*.json. EMBED_DEPLOYMENT must be the model the index
# was built with (see infra/variables.tf).
CHAT_DEPLOYMENT=gpt-4.1-mini
EMBED_DEPLOYMENT=text-embedding-3-small

# --- Azure AI Search ---
# Azure portal > your search service > Overview (URL) and Keys (admin key)
SEARCH_ENDPOINT=https://autoassist-search.search.windows.net
SEARCH_API_KEY=
SEARCH_INDEX_NAME=service-docs

# Retrieval tuning (services/orchestrator/retrieval.py). Optional; the values
# shown are the defaults in code. Change one and re-run `make evals`.
# RETRIEVAL_TOP_K=5                # chunks handed to the agent
# RETRIEVAL_FLOOR=0.0155           # RRF score below which a chunk is dropped
# RETRIEVAL_MAX_PER_SOURCE=2       # chunks any one file may contribute
# RETRIEVAL_CACHE_SECONDS=120      # how long an identical search is reused

# Our own logging. INFO shows each routing decision and each retrieval.
LOG_LEVEL=INFO
# Azure and HTTP client logging is extremely verbose. WARNING by default; set
# to INFO when you need to see the raw requests.
AZURE_LOG_LEVEL=WARNING

# --- Telemetry (optional) ---
# Azure portal > your Application Insights resource > Overview > Connection String
# Leave empty to run without telemetry - everything works, traces just stay local.
APPLICATIONINSIGHTS_CONNECTION_STRING=

# --- Bookings (optional) ---
# "file" (default) keeps bookings in a JSON file inside the container: lost on
# every deploy, not shared between replicas, no customer email.
# "zoho" books into Zoho Bookings through its MCP server, which also emails the
# customer. See docs/decisions/008-zoho-bookings.md
BOOKING_BACKEND=file

# Zoho Bookings, only needed when BOOKING_BACKEND=zoho (the live app uses it).
# ZOHO_MCP_URL contains an access key: treat it as a password, never commit it.
# Run scripts/zoho_login.py once to fill in the client id and refresh token.
ZOHO_MCP_URL=
ZOHO_MCP_CLIENT_ID=
ZOHO_MCP_REFRESH_TOKEN=
# Written by scripts/zoho_login.py only if Zoho issues a client secret when it
# registers the app. Leave it out otherwise.
# ZOHO_MCP_CLIENT_SECRET=
ZOHO_SERVICE_ID=
ZOHO_STAFF_ID=
ZOHO_TIMEZONE=Asia/Kolkata
# A single-line custom field on the service. Without it a reschedule wipes the
# registration and the booking's owner can no longer be checked, so moving is
# refused. Quote it: it has a space in it.
ZOHO_REGISTRATION_FIELD="Vehicle Registration"

# --- Protecting a public endpoint (optional) ---
# /chat has no sign-in, so these are what stop one visitor - or one curl loop -
# from spending the month's token quota in an afternoon.
# See docs/decisions/009-protecting-a-public-chat.md
# Any of them set to 0 is off. Counted per replica: there is no shared store.
RATE_LIMIT_PER_MINUTE=10
RATE_LIMIT_PER_HOUR=60
# Messages in flight per replica. Keep this ABOVE 10: Container Apps adds a
# replica past 10 concurrent requests each, and a lower cap would refuse the
# eleventh customer instead of letting the app scale out.
MAX_CONCURRENT_CHATS=20

# How long an identical question keeps its answer, in seconds. 0 turns the
# answer cache off, which is what the eval runners do.
ANSWER_CACHE_SECONDS=600

# --- Jev / TypeSafe (optional) ---
# Used by the service when TRIAGE_BACKEND=jev (services/orchestrator/jev_triage.py)
# and by evals/compare_triage.py. A key from the TypeSafe console at
# https://typesafe.ai. Treat it as a password; it is sent as a bearer token,
# never in a URL.
TYPESAFE_API_KEY=
# jev-latest moves. Pin the version when a measurement is worth repeating.
TYPESAFE_MODEL=jev-latest

# Which classifier decides the route: "agent" (gpt-4.1-mini writing JSON) or
# "jev" (four probabilities, thresholds in code). Needs TYPESAFE_API_KEY above.
# The live app's value comes from the deploy pipeline (docs/deploy.md), not here.
# Measured on evals/routing_set.jsonl, 72 cases, 21 Sep 2026:
#   routes right 52/72 vs 63/72 · safety false alarms 7 vs 2 · 2,118ms vs 352ms
# Anything Jev cannot answer falls back to the agent, so this is safe to flip.
TRIAGE_BACKEND=agent
# Where Jev's probabilities are cut into yes and no. Both were swept on the
# routing set; see the comment above them in jev_triage.py before moving them.
# JEV_INTENT_CUT=0.6
# JEV_SAFETY_CUT=0.7

# Jev as a judge (services/orchestrator/judgements.py, docs/evaluation.md
# finding 17). On wherever TYPESAFE_API_KEY is set, whatever TRIAGE_BACKEND says;
# when Jev cannot answer, the regex that was there before decides. 0 turns one off.
#   reassurance: withholds a safety answer that says it is fine to keep driving
#                (labelled set: regex 15/32, Jev 31/32; caught a reworded poisoned
#                bulletin the regex missed)
#   accepted call: whether a reply says yes to an advisor's call (24/28 vs 28/28)
#   maintenance: whether a message the keyword net alone flagged is only asking
#                when a part is due (19/29 vs 29/29) - recorded only, see below
# JEV_REASSURANCE_CHECK=1
# JEV_ACCEPTS_CALL_CHECK=1
# JEV_MAINTENANCE_CHECK=1
# Let the maintenance answer drop the keyword net's safety flag (Jev >= 0.7 and
# the classifier said no safety issue; for Jev routing, its safety score <= 0.10).
# Off: this changes the safety net, and is the owner's decision - docs/runbook.md.
KEYWORD_NET_MAINTENANCE_EXEMPTION=0
