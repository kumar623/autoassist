# Copy to .env and fill in. NEVER commit .env

# --- Azure AI Foundry project ---
# Foundry portal > your project > Overview > "Azure AI Foundry project endpoint"
PROJECT_ENDPOINT=https://rg-autoassist.services.ai.azure.com/api/projects/autoassist

# --- Azure OpenAI (same resource, different endpoint shape) ---
# Foundry portal > Models + endpoints > click gpt-4.1-mini > copy "Target URI"
# and keep only the part up to .com/  -- do NOT include /openai/deployments/...
AZURE_OPENAI_ENDPOINT=https://rg-autoassist.services.ai.azure.com/
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_API_VERSION=2025-04-01-preview

CHAT_DEPLOYMENT=gpt-4.1-mini
EMBED_DEPLOYMENT=text-embedding-3-small

# --- Azure AI Search ---
# Azure portal > your search service > Overview (URL) and Keys (admin key)
SEARCH_ENDPOINT=https://autoassist-search.search.windows.net
SEARCH_API_KEY=
SEARCH_INDEX_NAME=service-docs

# Optional. Leave EMPTY and the script finds the search connection automatically.
# Azure appends random characters to portal-created connection names, so only set
# this if you have more than one search connection and need to pick a specific one.
# Check yours with: python agents/deploy_agents.py --connections
SEARCH_CONNECTION_NAME=

# Semantic ranker is NOT available on the Free search tier.
# Leave this empty on Free. Set to "true" after upgrading to Basic or higher.
SEARCH_SEMANTIC=

# Azure SDK HTTP logging is extremely verbose. WARNING by default; set to INFO
# when you need to see the raw requests.
AZURE_LOG_LEVEL=WARNING

# --- Telemetry (optional) ---
# Azure portal > your Application Insights resource > Overview > Connection String
# Leave empty to run without telemetry - everything works, traces just stay local.
APPLICATIONINSIGHTS_CONNECTION_STRING=

# --- Bookings (optional) ---
# "file" (default) keeps bookings in a JSON file inside the container: lost on
# every deploy, not shared between replicas, no customer email.
# "zoho" books into Zoho Bookings through its MCP server, which also emails the
# customer. See docs/decisions/008-zoho-bookings.md
BOOKING_BACKEND=file

# Zoho Bookings, only needed when BOOKING_BACKEND=zoho.
# ZOHO_MCP_URL contains an access key: treat it as a password, never commit it.
# Run scripts/zoho_login.py once to fill in the client id and refresh token.
ZOHO_MCP_URL=
ZOHO_MCP_CLIENT_ID=
ZOHO_MCP_REFRESH_TOKEN=
ZOHO_SERVICE_ID=
ZOHO_STAFF_ID=
ZOHO_TIMEZONE=Asia/Kolkata
# A single-line custom field on the service. Without it a reschedule wipes the
# registration and the booking's owner can no longer be checked, so moving is
# refused. Quote it: it has a space in it.
ZOHO_REGISTRATION_FIELD="Vehicle Registration"
