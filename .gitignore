.env
.venv/
venv/
__pycache__/
*.pyc
.pytest_cache/
.ruff_cache/

# Terraform
.terraform/
*.tfstate
*.tfstate.*
*.tfvars
!*.tfvars.example
# .terraform.lock.hcl is deliberately NOT ignored. It pins the exact provider
# versions and their checksums, so `terraform init` on another machine installs
# byte-identical providers. Ignoring it is a common mistake - it is the
# equivalent of a package-lock.json.
# Saved plans. Binary, and they contain resource attributes - including values
# Terraform read back from Azure. Never commit one.
tfplan
*.tfplan

crash.log
override.tf
override.tf.json

# generated data - regenerate with scripts/generate_bulletins.py
data/synthetic_bulletins/*.pdf
data/synthetic_bulletins/manifest.json

.DS_Store

# local booking/ticket store - week 3 moves this to Azure Table Storage
data/bookings.json
data/tickets.json

# eval run output - keep the ones you want by committing them explicitly
evals/results/
