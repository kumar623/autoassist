.env
.venv/
venv/
__pycache__/
*.pyc
.pytest_cache/
.ruff_cache/

# Terraform
.terraform/
*.tfstate
*.tfstate.*
*.tfvars
!*.tfvars.example
# .terraform.lock.hcl is deliberately NOT ignored. It pins the exact provider
# versions and their checksums, so `terraform init` on another machine installs
# byte-identical providers. Ignoring it is a common mistake - it is the
# equivalent of a package-lock.json.
# Saved plans. Binary, and they contain resource attributes - including values
# Terraform read back from Azure. Never commit one.
tfplan
*.tfplan

crash.log
override.tf
override.tf.json

# Generated bulletins. The PDFs the live index was built from are gone, and
# regenerating makes different ones - see the `data` target in the Makefile.
data/synthetic_bulletins/*.pdf
data/synthetic_bulletins/manifest.json

.DS_Store

# Local stores: tickets always, bookings only when BOOKING_BACKEND=file. Live
# bookings are in Zoho Bookings (docs/decisions/008).
data/bookings.json
data/tickets.json

# eval run output - keep the ones you want by committing them explicitly
evals/results/

# Zoho sign-in link: contains the MCP URL and its key
.zoho-login-link

# Local dev-server config for the Claude Code browser preview.
.claude/
